# ============================================================
# 巡检系统统一配置文件

# ---------- 系统账户 ----------
# 管理员密码（可通过 Web 面板修改，仅支持单用户）
ADMIN_PASSWORD=Lumi.3475441308

# ---------- 主控端配置 (controller) ----------

# 主控端监听地址，0.0.0.0 表示监听所有网卡
CONTROLLER_HOST=0.0.0.0
# 主控端监听端口
CONTROLLER_PORT=8578
# 心跳超时判离线阈值（秒），超过该时间未收到心跳视为离线
ALIVE_TIMEOUT_SECONDS=35
# 状态持久化文件路径，记录所有 agent 的状态数据
STATE_FILE=controller_state.json
# 巡检报告原始输出归档目录
REPORT_ARCHIVE_DIR=report_archive

# ---------- 代理端配置 (agent) ----------

# 主控端地址，agent 向此地址发送心跳和巡检结果
CONTROLLER_BASE_URL=http://47.108.161.146:8578
# 心跳间隔（秒），每隔该时间向主控端发送一次心跳
HEARTBEAT_INTERVAL_SECONDS=15
# 每 N 次心跳执行一次全量巡检，默认 40 即约每 10 分钟巡检一次
CHECK_EVERY_N_HEARTBEATS=40
# 机器唯一标识，留空则自动使用主机名
AGENT_ID=
# 巡检时可选的单进程名，传给 process_check.sh 作为参数。留空则使用 PROCESS_TARGETS
PROCESS_NAME=

# ---------- 系统巡检阈值 ----------

# CPU 使用率告警阈值（百分比），超过该值触发 WARNING
CPU_WARNING=80
# 内存使用率告警阈值（百分比），超过该值触发 WARNING
MEM_WARNING=85
# 磁盘使用率告警阈值（百分比），超过该值触发 WARNING
DISK_WARNING=85
# inode 使用率告警阈值（百分比），超过该值触发 WARNING
INODE_WARNING=80
# Swap 使用量告警阈值（MB），超过该值触发 WARNING
SWAP_WARNING_MB=100

# ---------- 进程巡检参数 ----------

# CPU 空闲判定阈值（百分比），进程 CPU 占用低于该值可能判定为假死
CPU_IDLE_THRESHOLD=1
# 进程 CPU 采样间隔（秒），两次采样之间的等待时间
CHECK_INTERVAL=3
# 线程阻塞告警阈值，D 状态线程数超过该值视为疑似死锁
THREAD_BLOCK_THRESHOLD=5
# 文件描述符数量告警阈值，超过该值视为可能存在资源泄漏
FD_WARNING_THRESHOLD=10000
# 监控进程列表（逗号分隔），巡检时会逐一检查这些进程的健康状态
PROCESS_TARGETS=sshd,nginx,mysqld,redis-server

# ---------- 安全基线配置 ----------

# SSH 配置文件路径，用于检查 PermitRootLogin 和 PasswordAuthentication 等配置
SSH_CONFIG_FILE=/etc/ssh/sshd_config
# 密码最大有效天数建议值，超过该值触发 WARNING
MAX_PASSWORD_DAYS=90
# 密码最短长度建议值，低于该值触发 WARNING
MIN_PASSWORD_LENGTH=8
